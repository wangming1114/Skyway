<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skyway.resource.mapper.VpsInstanceMapper">

    <resultMap type="com.skyway.resource.domain.VpsInstance" id="VpsInstanceResult">
        <id     property="id"           column="id"            />
        <result property="name"         column="name"          />
        <result property="categoryId"   column="category_id"   />
        <result property="nodeId"       column="node_id"       />
        <result property="ip"          column="ip"            />
        <result property="sshPort"     column="ssh_port"      />
        <result property="sshUsername" column="ssh_username"  />
        <result property="sshPassword" column="ssh_password"  />
        <result property="cpu"          column="cpu"           />
        <result property="memory"       column="memory"        />
        <result property="disk"        column="disk"          />
        <result property="status"      column="status"        />
        <result property="remark"      column="remark"        />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
        <result property="categoryName" column="category_name" />
        <result property="nodeName"     column="node_name"     />
    </resultMap>

    <sql id="selectVpsInstanceVo">
        select i.id, i.name, i.category_id, i.node_id, i.ip, i.ssh_port, i.ssh_username, i.ssh_password, i.cpu, i.memory, i.disk, i.status, i.remark, i.create_time, i.update_time,
               c.name as category_name,
               n.name as node_name
        from res_instance i
        left join res_category c on i.category_id = c.id
        left join res_category n on i.node_id = n.id
    </sql>

    <select id="selectList" parameterType="com.skyway.resource.domain.VpsInstance" resultMap="VpsInstanceResult">
        <include refid="selectVpsInstanceVo"/>
        <where>
            <if test="keyword != null and keyword != ''">
                and (i.name like concat('%', #{keyword}, '%') or cast(i.id as char) like concat('%', #{keyword}, '%') or (i.ip is not null and i.ip like concat('%', #{keyword}, '%')))
            </if>
            <!-- 选中节点及其所有子分类下的实例（由 service 注入 categoryIds） -->
            <if test="categoryIds != null and categoryIds.size() > 0">
                and i.category_id in
                <foreach collection="categoryIds" item="id" open="(" separator="," close=")">#{id}</foreach>
            </if>
            <if test="categoryId != null and (categoryIds == null or categoryIds.size() == 0)"> and i.category_id = #{categoryId} </if>
            <if test="nodeId != null"> and i.node_id = #{nodeId} </if>
            <if test="status != null and status != ''"> and i.status = #{status} </if>
        </where>
        order by i.create_time desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="VpsInstanceResult">
        <include refid="selectVpsInstanceVo"/>
        where i.id = #{id}
    </select>

    <insert id="insert" parameterType="com.skyway.resource.domain.VpsInstance" useGeneratedKeys="true" keyProperty="id">
        insert into res_instance (name, category_id, node_id, ip, ssh_port, ssh_username, ssh_password, cpu, memory, disk, status, remark, create_time, update_time)
        values (#{name}, #{categoryId}, #{nodeId}, #{ip}, #{sshPort}, #{sshUsername}, #{sshPassword}, #{cpu}, #{memory}, #{disk}, #{status}, #{remark}, sysdate(), sysdate())
    </insert>

    <update id="update" parameterType="com.skyway.resource.domain.VpsInstance">
        update res_instance
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="nodeId != null">node_id = #{nodeId},</if>
            <if test="ip != null">ip = #{ip},</if>
            <if test="sshPort != null">ssh_port = #{sshPort},</if>
            <if test="sshUsername != null">ssh_username = #{sshUsername},</if>
            <if test="sshPassword != null">ssh_password = #{sshPassword},</if>
            <if test="cpu != null">cpu = #{cpu},</if>
            <if test="memory != null">memory = #{memory},</if>
            <if test="disk != null">disk = #{disk},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from res_instance where id = #{id}
    </delete>
</mapper>
