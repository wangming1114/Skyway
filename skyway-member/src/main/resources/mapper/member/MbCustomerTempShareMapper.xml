<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skyway.member.mapper.MbCustomerTempShareMapper">

    <resultMap type="com.skyway.member.domain.MbCustomerTempShare" id="MbCustomerTempShareResult">
        <id     property="id"             column="id"              />
        <result property="customerId"     column="customer_id"     />
        <result property="token"          column="token"           />
        <result property="accessPassword" column="access_password" />
        <result property="expireTime"     column="expire_time"     />
        <result property="status"         column="status"          />
        <result property="remark"         column="remark"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
    </resultMap>

    <sql id="selectMbCustomerTempShareVo">
        select id, customer_id, token, access_password, expire_time, status, remark, create_by, create_time, update_by, update_time
        from mb_customer_temp_share
    </sql>

    <select id="selectByCustomerId" parameterType="Long" resultMap="MbCustomerTempShareResult">
        <include refid="selectMbCustomerTempShareVo"/>
        where customer_id = #{customerId}
        order by create_time desc
    </select>

    <select id="selectByToken" parameterType="String" resultMap="MbCustomerTempShareResult">
        <include refid="selectMbCustomerTempShareVo"/>
        where token = #{token}
        limit 1
    </select>

    <insert id="insert" parameterType="com.skyway.member.domain.MbCustomerTempShare" useGeneratedKeys="true" keyProperty="id">
        insert into mb_customer_temp_share (customer_id, token, access_password, expire_time, status, create_by, create_time, update_time)
        values (#{customerId}, #{token}, #{accessPassword}, #{expireTime}, #{status}, #{createBy}, sysdate(), sysdate())
    </insert>

    <update id="revoke">
        update mb_customer_temp_share
        set status = '1', update_by = #{param2}, update_time = sysdate()
        where id = #{param1}
    </update>
</mapper>
